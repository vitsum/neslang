// ===== VARIABLES =====
byte i = 0;
byte j = 0;
byte frame = 0;
byte tick = 0;
byte pose = 0;
byte yoff = 0;
byte body_l = 0;
byte body_r = 0;
byte legs_l = 0;
byte legs_r = 0;
byte cycle = 0;
byte s0 = 0;
byte s1 = 0;
byte s2 = 0;
byte s3 = 0;
byte s4 = 0;
byte s5 = 0;
byte s6 = 0;
byte s7 = 0;

func draw_char_pose(byte sid, byte px, byte py, byte p0, byte p1, byte p2, byte ps) {
    if (ps == 0) { body_l = 20;  body_r = 21;  legs_l = 22;  legs_r = 23; }
    if (ps == 1) { body_l = 91;  body_r = 92;  legs_l = 93;  legs_r = 94; }
    if (ps == 2) { body_l = 95;  body_r = 96;  legs_l = 97;  legs_r = 98; }
    if (ps == 3) { body_l = 99;  body_r = 100; legs_l = 101; legs_r = 102; }

    sprite(sid,     px,     py,      16,     p0);
    sprite(sid + 1, px + 8, py,      17,     p0);
    sprite(sid + 2, px,     py + 8,  18,     p0);
    sprite(sid + 3, px + 8, py + 8,  19,     p0);
    sprite(sid + 4, px,     py + 16, body_l, p1);
    sprite(sid + 5, px + 8, py + 16, body_r, p1);
    sprite(sid + 6, px,     py + 24, legs_l, p2);
    sprite(sid + 7, px + 8, py + 24, legs_r, p2);
}

func get_dance(byte t) {
    // t = tick 0..31
    // Sets global pose and yoff
    if (t < 8)   { pose = 0; yoff = 0; }
    if (t >= 8)  { if (t < 16) { pose = 1; yoff = 4; } }
    if (t >= 16) { if (t < 24) { pose = 2; yoff = 7; } }
    if (t >= 24) { pose = 3; yoff = 4; }
}

func draw_bg() {
    // Stars
    bg_addr(3, 2);   bg_byte(26);
    bg_addr(10, 4);  bg_byte(26);
    bg_addr(18, 1);  bg_byte(26);
    bg_addr(25, 3);  bg_byte(26);
    bg_addr(7, 1);   bg_byte(26);
    bg_addr(28, 5);  bg_byte(26);
    bg_addr(14, 2);  bg_byte(26);
    bg_addr(20, 0);  bg_byte(26);
    bg_addr(1, 4);   bg_byte(26);
    bg_addr(30, 1);  bg_byte(26);

    // Music notes
    bg_addr(5, 3);   bg_byte(29);
    bg_addr(12, 1);  bg_byte(29);
    bg_addr(22, 2);  bg_byte(29);
    bg_addr(29, 4);  bg_byte(29);
    bg_addr(16, 5);  bg_byte(29);

    // Back platform for back row (row 16-17)
    i = 1;
    while (i < 31) {
        bg_addr(i, 17);
        bg_byte(24);
        i = i + 1;
    }

    // Front platform (row 22-23)
    i = 0;
    while (i < 32) {
        bg_addr(i, 22);
        bg_byte(24);
        bg_addr(i, 23);
        bg_byte(24);
        i = i + 1;
    }

    // Grass top (row 24)
    i = 0;
    while (i < 32) {
        bg_addr(i, 24);
        bg_byte(27);
        i = i + 1;
    }

    // Ground (rows 25-29)
    j = 25;
    while (j < 30) {
        i = 0;
        while (i < 32) {
            bg_addr(i, j);
            bg_byte(25);
            i = i + 1;
        }
        j = j + 1;
    }

    // Castle towers
    i = 0;
    while (i < 3) {
        bg_addr(1 + i, 14);  bg_byte(28);
        bg_addr(1 + i, 15);  bg_byte(28);
        bg_addr(1 + i, 16);  bg_byte(28);
        bg_addr(28 + i, 14); bg_byte(28);
        bg_addr(28 + i, 15); bg_byte(28);
        bg_addr(28 + i, 16); bg_byte(28);
        i = i + 1;
    }

    // Attributes
    i = 0;
    while (i < 8) {
        bg_attr(i, 0, 0x00);
        bg_attr(i, 1, 0x00);
        bg_attr(i, 2, 0x55);
        bg_attr(i, 3, 0x00);
        bg_attr(i, 4, 0xFF);
        bg_attr(i, 5, 0xFF);
        bg_attr(i, 6, 0xAA);
        bg_attr(i, 7, 0xAA);
        i = i + 1;
    }

    bg_text(3, 7, "-- COLOR PARADE --");
    bg_text(5, 9, "DANCE! DANCE!");
}

func main() {
    ppu_off();

    // BG palettes
    color(0,  0x0F, 0x30, 0x21, 0x02);
    color(4,  0x0F, 0x30, 0x2C, 0x1C);
    color(8,  0x0F, 0x2A, 0x0A, 0x07);
    color(12, 0x0F, 0x27, 0x06, 0x10);

    // Sprite palettes — max variety
    color(16, 0x0F, 0x30, 0x16, 0x36);
    color(20, 0x0F, 0x30, 0x12, 0x28);
    color(24, 0x0F, 0x30, 0x2A, 0x27);
    color(28, 0x0F, 0x30, 0x14, 0x36);

    enable_sound();
    music_init();
    draw_bg();
    ppu_on();

    while (true) {
        vblank();
        frame = frame + 1;

        // === OAM CYCLING ===
        // Rotate sprite slot assignments each frame
        // Even frames: back row gets low slots (priority)
        // Odd frames: front row gets low slots (priority)
        // This creates classic NES flicker if rows ever overlap

        cycle = frame & 1;

        if (cycle == 0) {
            // Back row = high priority (slots 0-31)
            s0 = 0;  s1 = 8;  s2 = 16; s3 = 24;
            // Front row = low priority (slots 32-63)
            s4 = 32; s5 = 40; s6 = 48; s7 = 56;
        }
        if (cycle == 1) {
            // Front row = high priority
            s4 = 0;  s5 = 8;  s6 = 16; s7 = 24;
            // Back row = low priority
            s0 = 32; s1 = 40; s2 = 48; s3 = 56;
        }

        // =============================================
        //  BACK ROW: 4 chars — y base = 104
        //  Max 4 chars × 2 sprites wide = 8 per scanline ✓
        //  x: 24, 80, 136, 192 (spaced 56px)
        // =============================================

        // Char 1: Red Knight
        tick = frame & 31;
        get_dance(tick);
        draw_char_pose(s0, 24, 104 - yoff, 0, 0, 0, pose);

        // Char 2: Blue Mage — offset 8
        tick = (frame + 8) & 31;
        get_dance(tick);
        draw_char_pose(s1, 80, 104 - yoff, 1, 1, 1, pose);

        // Char 3: Green Ranger — offset 16
        tick = (frame + 16) & 31;
        get_dance(tick);
        draw_char_pose(s2, 136, 104 - yoff, 2, 2, 2, pose);

        // Char 4: Purple Wizard — offset 24
        tick = (frame + 24) & 31;
        get_dance(tick);
        draw_char_pose(s3, 192, 104 - yoff, 3, 3, 3, pose);

        // =============================================
        //  FRONT ROW: 4 chars — y base = 143
        //  Offset X to create V-formation (between back row)
        //  Back row bottom: 104+32 = 136
        //  Front row top: 143 - 7(max bounce) = 136
        //  Minimal overlap only during peak bounce — OAM cycling handles it!
        // =============================================

        // Char 5: Mixed Red/Blue/Green — offset 4
        tick = (frame + 4) & 31;
        get_dance(tick);
        draw_char_pose(s4, 52, 143 - yoff, 0, 1, 2, pose);

        // Char 6: Mixed Purple/Green/Red — offset 12
        tick = (frame + 12) & 31;
        get_dance(tick);
        draw_char_pose(s5, 108, 143 - yoff, 3, 2, 0, pose);

        // Char 7: Mixed Blue/Purple/Green — offset 20
        tick = (frame + 20) & 31;
        get_dance(tick);
        draw_char_pose(s6, 164, 143 - yoff, 1, 3, 2, pose);

        // Char 8: Mixed Green/Red/Purple — offset 28
        tick = (frame + 28) & 31;
        get_dance(tick);
        draw_char_pose(s7, 220, 143 - yoff, 2, 0, 3, pose);

        // Music engine tick — one frame of music
        music_tick();

        scroll(0, 0);
    }
}
